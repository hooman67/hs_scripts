+@pytest.mark.parametrize("side,user_axis_name,user_sign", [
+    ("near_camera", "depth", -1), ("far_from_camera", "depth", 1),
+    ("width_left", "width", -1), ("width_right", "width", 1),
+])
+def test_oval_gap_uses_selected_user_axis_at_product_aligned_rim(side, user_axis_name, user_sign):
+    from hp3p.geometry import build_guide
+
+    geometry = spec(support_top_shape="oval", support_depth_m=0.8, user_side=side,
+                    user_edge_gap_m=0.04, support_lateral_offset_m=0.05)
+    _, info = build_guide(*scene(), geometry)
+    w, h = 400, 300
+    pitch = math.atan2(geometry["camera_height_m"] - geometry["look_at_height_m"],
+                       geometry["horizontal_distance_m"])
+    focal = h / (2 * math.tan(math.radians(geometry["vertical_fov_deg"]) / 2))
+    rotation = np.array([[1, 0, 0], [0, -math.cos(pitch), -math.sin(pitch)],
+                         [0, -math.sin(pitch), math.cos(pitch)]])
+    camera = np.array([0, geometry["camera_height_m"], 0])
+
+    def back_project(pixel):
+        u, v = pixel
+        ray = rotation.T @ np.array([(u - w / 2) / focal, (v - h / 2) / focal, 1])
+        return camera + ray * ((geometry["support_height_m"] - camera[1]) / ray[1])
+
+    yaw = math.radians(geometry["axis_angle_deg"])
+    width_axis = np.array([math.cos(yaw), 0, math.sin(yaw)])
+    depth_axis = np.array([-math.sin(yaw), 0, math.cos(yaw)])
+    axes = {"width": width_axis, "depth": depth_axis}
+    center = back_project(info["contact_px"])
+    near_end = -math.copysign(1, yaw)
+    base_center = (center - near_end * geometry["product_footprint_width_m"] / 2 * width_axis
+                   + geometry["product_footprint_depth_m"] / 2 * depth_axis)
+    user_axis = axes[user_axis_name]
+    base_half = (geometry["product_footprint_width_m"] / 2 if user_axis_name == "width" else
+                 geometry["product_footprint_depth_m"] / 2)
+    base_edge_center = base_center + user_sign * base_half * user_axis
+    to_rim = back_project(info["user_edge_center_px"]) - base_edge_center
+    assert np.dot(to_rim, user_sign * user_axis) == pytest.approx(geometry["user_edge_gap_m"])
+    assert np.linalg.norm(to_rim - np.dot(to_rim, user_axis) * user_axis) == pytest.approx(0, abs=1e-10)
+
