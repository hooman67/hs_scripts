{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.adobe.com/schemas/hp-natural-placement-v4.1-result.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "assessment",
    "derived",
    "error",
    "raw_attempts",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "hp-natural-placement-v4.1-result-v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ]
    },
    "derived": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_input",
                "transport_failure",
                "invalid_model_output",
                "unassessable_input",
                "audit_failure"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "raw_attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "audit_id",
          "validation_status"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "audit_id": {
            "type": "string",
            "minLength": 1
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "transport_error"
            ]
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "model_requested",
        "model_returned",
        "input_fingerprint",
        "system_prompt_sha256",
        "assessment_schema_sha256",
        "scoring_sha256",
        "target_record_id",
        "anchor_catalog_sha256",
        "anchor_plan_sha256",
        "selected_anchor_ids"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "model_requested": {
          "type": "string",
          "minLength": 1
        },
        "model_returned": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "system_prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assessment_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scoring_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor_catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "anchor_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_anchor_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
