{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.adobe.com/schemas/placement-observations-v4.json",
  "title": "Natural placement model observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_match",
    "product_match_note",
    "scene_reading",
    "view_class",
    "context_visibility",
    "inspection_checks",
    "defect_inventory",
    "verification",
    "components",
    "summary",
    "creative_advisories",
    "suggested_scene_changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "placement-observations-v4"
    },
    "product_match": {
      "type": "string",
      "enum": [
        "match",
        "uncertain",
        "mismatch"
      ]
    },
    "product_match_note": {
      "type": "string"
    },
    "scene_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional_front",
        "support_surface",
        "usable_approach_edge",
        "actual_user_position",
        "access_path",
        "device_support_axes",
        "neighboring_furniture",
        "narrative_status",
        "narrative_evidence",
        "support_placement_in_room",
        "usable_space_distribution",
        "alternative_user_positions",
        "prop_relationships",
        "lived_in_evidence"
      ],
      "properties": {
        "functional_front": {
          "type": "string",
          "minLength": 1
        },
        "support_surface": {
          "type": "string",
          "minLength": 1
        },
        "usable_approach_edge": {
          "type": "string",
          "minLength": 1
        },
        "actual_user_position": {
          "type": "string",
          "minLength": 1
        },
        "access_path": {
          "type": "string",
          "minLength": 1
        },
        "device_support_axes": {
          "type": "string",
          "minLength": 1
        },
        "neighboring_furniture": {
          "type": "string",
          "minLength": 1
        },
        "narrative_status": {
          "type": "string",
          "enum": [
            "supported",
            "contradicted",
            "unclear"
          ]
        },
        "narrative_evidence": {
          "type": "string",
          "minLength": 1
        },
        "support_placement_in_room": {
          "type": "string",
          "minLength": 1
        },
        "usable_space_distribution": {
          "type": "string",
          "minLength": 1
        },
        "alternative_user_positions": {
          "type": "string",
          "minLength": 1
        },
        "prop_relationships": {
          "type": "string",
          "minLength": 1
        },
        "lived_in_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_scenario",
        "access_usability",
        "orientation_alignment",
        "scale_perspective",
        "contact_integration"
      ],
      "properties": {
        "support_scenario": {
          "$ref": "#/$defs/support_scenario"
        },
        "access_usability": {
          "$ref": "#/$defs/access_usability"
        },
        "orientation_alignment": {
          "$ref": "#/$defs/orientation_alignment"
        },
        "scale_perspective": {
          "$ref": "#/$defs/scale_perspective"
        },
        "contact_integration": {
          "$ref": "#/$defs/contact_integration"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "creative_advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "style_wall_unresolved",
              "style_art_framing",
              "style_prop_relevance",
              "style_sparse_staging"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suggested_scene_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "view_class": {
      "type": "string",
      "enum": [
        "close",
        "medium",
        "wide"
      ]
    },
    "context_visibility": {
      "type": "string",
      "enum": [
        "adequate",
        "partial",
        "minimal"
      ]
    },
    "inspection_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rigid_edges_corners",
        "thickness_joints",
        "support_load_paths",
        "room_depth_relations",
        "station_anchoring",
        "device_support_contact",
        "prop_interactions",
        "incidental_prop_geometry",
        "user_access"
      ],
      "properties": {
        "rigid_edges_corners": {
          "$ref": "#/$defs/inspection_check"
        },
        "thickness_joints": {
          "$ref": "#/$defs/inspection_check"
        },
        "support_load_paths": {
          "$ref": "#/$defs/inspection_check"
        },
        "room_depth_relations": {
          "$ref": "#/$defs/inspection_check"
        },
        "station_anchoring": {
          "$ref": "#/$defs/inspection_check"
        },
        "device_support_contact": {
          "$ref": "#/$defs/inspection_check"
        },
        "prop_interactions": {
          "$ref": "#/$defs/inspection_check"
        },
        "incidental_prop_geometry": {
          "$ref": "#/$defs/inspection_check"
        },
        "user_access": {
          "$ref": "#/$defs/inspection_check"
        }
      }
    },
    "defect_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_contradictions_rechecked",
        "severity_zero_evidence_checked",
        "hidden_geometry_not_assumed",
        "creative_advisories_not_scored",
        "corrected_assignments",
        "notes"
      ],
      "properties": {
        "structural_contradictions_rechecked": {
          "type": "boolean",
          "const": true
        },
        "severity_zero_evidence_checked": {
          "type": "boolean",
          "const": true
        },
        "hidden_geometry_not_assumed": {
          "type": "boolean",
          "const": true
        },
        "creative_advisories_not_scored": {
          "type": "boolean",
          "const": true
        },
        "corrected_assignments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "support_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "severity",
        "confidence",
        "evidence",
        "consequence",
        "issue_codes",
        "supporting_check_ids",
        "finding_ids"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "observed",
            "partial",
            "unobservable"
          ]
        },
        "severity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "inappropriate_support",
              "occupied_workstation",
              "implausible_scenario",
              "unsupported_base",
              "unmotivated_position",
              "incoherent_use_arrangement",
              "misplaced_support_furniture",
              "unpopulated_storage",
              "bare_staged_setting",
              "room_anchor_conflict"
            ]
          }
        },
        "supporting_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rigid_edges_corners",
              "thickness_joints",
              "support_load_paths",
              "room_depth_relations",
              "station_anchoring",
              "device_support_contact",
              "prop_interactions",
              "incidental_prop_geometry",
              "user_access"
            ]
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          }
        }
      }
    },
    "access_usability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "severity",
        "confidence",
        "evidence",
        "consequence",
        "issue_codes",
        "supporting_check_ids",
        "finding_ids"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "observed",
            "partial",
            "unobservable"
          ]
        },
        "severity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "excessive_reach",
              "precarious_edge",
              "blocked_operating_side",
              "no_user_position",
              "furniture_collision",
              "blocked_paper_or_lid_path",
              "blocked_user_workspace",
              "liquid_crowding"
            ]
          }
        },
        "supporting_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rigid_edges_corners",
              "thickness_joints",
              "support_load_paths",
              "room_depth_relations",
              "station_anchoring",
              "device_support_contact",
              "prop_interactions",
              "incidental_prop_geometry",
              "user_access"
            ]
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          }
        }
      }
    },
    "orientation_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "severity",
        "confidence",
        "evidence",
        "consequence",
        "issue_codes",
        "supporting_check_ids",
        "finding_ids"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "observed",
            "partial",
            "unobservable"
          ]
        },
        "severity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "corner_facing",
              "furniture_axis_conflict",
              "chair_alignment_conflict",
              "furniture_layout_conflict",
              "ancillary_axis_conflict",
              "product_support_misalignment",
              "room_plane_conflict"
            ]
          }
        },
        "supporting_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rigid_edges_corners",
              "thickness_joints",
              "support_load_paths",
              "room_depth_relations",
              "station_anchoring",
              "device_support_contact",
              "prop_interactions",
              "incidental_prop_geometry",
              "user_access"
            ]
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          }
        }
      }
    },
    "scale_perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "severity",
        "confidence",
        "evidence",
        "consequence",
        "issue_codes",
        "supporting_check_ids",
        "finding_ids"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "observed",
            "partial",
            "unobservable"
          ]
        },
        "severity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "implausible_scale",
              "conflicting_perspective",
              "malformed_support_furniture",
              "missing_support_structure"
            ]
          }
        },
        "supporting_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rigid_edges_corners",
              "thickness_joints",
              "support_load_paths",
              "room_depth_relations",
              "station_anchoring",
              "device_support_contact",
              "prop_interactions",
              "incidental_prop_geometry",
              "user_access"
            ]
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          }
        }
      }
    },
    "contact_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "severity",
        "confidence",
        "evidence",
        "consequence",
        "issue_codes",
        "supporting_check_ids",
        "finding_ids"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "observed",
            "partial",
            "unobservable"
          ]
        },
        "severity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "consequence": {
          "type": "string"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "floating",
              "sinking_or_intersection",
              "inconsistent_shadow",
              "inconsistent_reflection",
              "prop_device_conflict",
              "malformed_incidental_prop"
            ]
          }
        },
        "supporting_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rigid_edges_corners",
              "thickness_joints",
              "support_load_paths",
              "room_depth_relations",
              "station_anchoring",
              "device_support_contact",
              "prop_interactions",
              "incidental_prop_geometry",
              "user_access"
            ]
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          }
        }
      }
    },
    "inspection_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "result",
        "evidence",
        "limitation",
        "alternative",
        "alternative_status",
        "finding_ids"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "adequate",
            "partial",
            "none"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "consistent",
            "contradiction",
            "ambiguous",
            "unobservable",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "enum": [
            "none",
            "crop",
            "occlusion",
            "resolution",
            "insufficient_context"
          ]
        },
        "alternative": {
          "type": "string",
          "enum": [
            "perspective",
            "crop_occlusion",
            "pedestal",
            "cantilever",
            "other_visible_support",
            "none"
          ]
        },
        "alternative_status": {
          "type": "string",
          "enum": [
            "supported",
            "possible_but_unverified",
            "contradicted",
            "not_applicable"
          ]
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "defect_type",
        "image_region",
        "evidence",
        "basis",
        "primary_component",
        "severity_recommendation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[1-9][0-9]*$"
        },
        "defect_type": {
          "type": "string"
        },
        "image_region": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "enum": [
            "physical_geometry",
            "usability",
            "station_policy",
            "incidental_geometry"
          ]
        },
        "primary_component": {
          "type": "string",
          "enum": [
            "support_scenario",
            "access_usability",
            "orientation_alignment",
            "scale_perspective",
            "contact_integration"
          ]
        },
        "severity_recommendation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
