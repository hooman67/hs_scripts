+            fixed_position=fixed_position,
+            product_mask=product_mask,
+        )
+        assert result["matches"] >= 3
+        assert result["verdict"] == "unverifiable"
+        assert result["reasons"] == ["affine_fit_failed"]
+        assert "textureless_fallback" not in result
